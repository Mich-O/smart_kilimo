FLASK_ENV=development
FLASK_SECRET_KEY=replace-with-long-random-string
INTERNAL_API_TOKEN=replace-with-another-random-string
DATABASE_URL=sqlite:///smart_kilimo.db
AT_USERNAME=sandbox
AT_API_KEY=your-at-api-key-here
AT_SENDER_ID=SmartKilimo
AT_ENVIRONMENT=sandbox
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEZONE=Africa/Nairobi
WEATHER_PAST_DAYS=1
RAINFALL_RESET_THRESHOLD_MM=5.0
DAILY_CYCLE_HOUR=6
DAILY_CYCLE_MINUTE=0
REMINDER_INTERVAL_HOURS=4
MAX_REMINDERS=3
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
# Set to true to have scripts/seed_demo_data.py populate sample farmers on
# every boot (see render.yaml). Defaults to false -- a real deployment
# with real farmers should not silently grow fake demo accounts.
SEED_DEMO_DATA=false
# For local dev, DATABASE_URL above (sqlite:///smart_kilimo.db) is fine.
# For a hosted deployment (e.g. Render), point this at a managed Postgres
# instance instead, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/smart_kilimo
